{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "highlight", "background", "transition"],
  "properties": {
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["color", "fontSize", "weight", "alignment"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "fontSize": {"enum": ["small", "medium", "large"]},
        "weight": {"enum": ["regular", "medium", "semibold", "bold"]},
        "alignment": {"enum": ["leading", "center", "trailing"]}
      }
    },
    "highlight": {
      "type": "object", "additionalProperties": false,
      "required": ["color", "mode"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "mode": {"enum": ["line", "word"]}
      }
    },
    "background": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "color"],
          "properties": {"type": {"const": "solid"}, "color": {"$ref": "#/$defs/color"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "colors", "direction"],
          "properties": {
            "type": {"const": "gradient"},
            "colors": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/color"}},
            "direction": {"enum": ["horizontal", "vertical", "diagonal"]}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "asset", "scaling"],
          "properties": {
            "type": {"const": "image"},
            "asset": {"type": "string", "maxLength": 180, "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(png|jpg|jpeg)$"},
            "scaling": {"enum": ["fit", "fill"]}
          }
        }
      ]
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["effect", "durationMs"],
      "properties": {
        "effect": {"enum": ["none", "fade", "slide"]},
        "durationMs": {"type": "integer", "minimum": 0, "maximum": 500}
      }
    }
  },
  "$defs": {"color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"}}
}
