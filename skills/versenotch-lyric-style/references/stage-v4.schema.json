{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "desktopFrame",
    "captions",
    "gapShots"
  ],
  "properties": {
    "desktopFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cue",
          "frame",
          "opacity",
          "tilt"
        ],
        "properties": {
          "cue": {
            "type": "string",
            "enum": [
              "previous",
              "current",
              "next"
            ]
          },
          "frame": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "opacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "tilt": {
            "type": "integer",
            "minimum": -30,
            "maximum": 30
          }
        }
      }
    },
    "gapShots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "columns",
          "rows",
          "cycleMs",
          "holdMs"
        ],
        "properties": {
          "asset": {
            "type": "string",
            "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:png|jpg|jpeg)$"
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "cycleMs": {
            "type": "integer",
            "minimum": 250,
            "maximum": 120000
          },
          "holdMs": {
            "type": "integer",
            "minimum": 250,
            "maximum": 120000
          }
        }
      }
    }
  }
}
