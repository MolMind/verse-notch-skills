{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "type", "version", "author", "license", "minAppVersion", "pluginAPIVersion", "entry", "permissions"],
  "properties": {
    "manifestVersion": {"type": "integer", "const": 1},
    "id": {"type": "string", "maxLength": 128, "pattern": "^(?!builtin\\.|com\\.verse-notch(?:\\.|$))[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
    "type": {"const": "lyric-style"},
    "version": {"$ref": "#/$defs/version"},
    "author": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "license": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "minAppVersion": {"$ref": "#/$defs/version"},
    "pluginAPIVersion": {"type": "integer", "const": 1},
    "entry": {"const": "style.json"},
    "permissions": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
